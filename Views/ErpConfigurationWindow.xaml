<Window x:Class="PpEvidencija.Views.ErpConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konfiguracija ERP baze"
        Width="600" Height="690" MinWidth="520" MinHeight="470"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Margin="20" Padding="24" Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Konfiguracija ERP baze" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,20" Style="{StaticResource HelperText}"
                               Text="Zajedničke postavke za korisnike i konta. Promjene se koriste pri narednoj prijavi; otvorene sesije zadržavaju svoje postavke." />
                    <StackPanel x:Name="pnlPolja">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SQL instanca" />
                        <TextBox x:Name="txtServer" MaxLength="256" AutomationProperties.Name="SQL instanca" />
                        <TextBlock Margin="0,4,0,16" Style="{StaticResource HelperText}" Text="Naziv servera ili server\instanca" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Naziv baze" />
                        <TextBox x:Name="txtDatabase" MaxLength="128" AutomationProperties.Name="Naziv baze" />
                        <TextBlock Margin="0,16,0,6" Style="{StaticResource FieldLabel}" Text="SQL korisničko ime" />
                        <TextBox x:Name="txtUser" MaxLength="128" AutomationProperties.Name="SQL korisničko ime" />
                        <TextBlock Margin="0,16,0,6" Style="{StaticResource FieldLabel}" Text="SQL lozinka" />
                        <PasswordBox x:Name="txtPassword" MaxLength="128" AutomationProperties.Name="SQL lozinka" />
                        <TextBlock x:Name="txtPasswordHint" Margin="0,4,0,0" Style="{StaticResource HelperText}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock x:Name="txtStatus" MinHeight="48"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                <Button x:Name="btnPonovoUcitaj" Content="Ponovo učitaj" Visibility="Collapsed"
                        HorizontalAlignment="Left" Click="BtnPonovoUcitaj_Click" />
            </StackPanel>
            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="btnTest" Margin="0,0,8,0" Content="Testiraj konekciju" Click="BtnTest_Click" />
                <Button x:Name="btnOdustani" Margin="0,0,8,0" Content="Odustani" IsCancel="True" Click="BtnOdustani_Click" />
                <Button x:Name="btnSacuvaj" Content="Sačuvaj" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="BtnSacuvaj_Click" />
            </WrapPanel>
        </Grid>
    </Border>
</Window>
