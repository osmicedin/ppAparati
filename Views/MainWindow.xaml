<Window x:Class="PpEvidencija.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidencija PP aparata"
        Width="1380"
        Height="850"
        MinWidth="1000"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryBrush}">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Evidencija PP aparata"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Unos servisiranih aparata i mjesečni zapisnici"
                               Foreground="#F8DEE4" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,7"
                        VerticalAlignment="Center"
                        Background="#2EFFFFFF"
                        CornerRadius="18">
                    <TextBlock x:Name="txtPrijavljeniKorisnik"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="24,16,24,12">
            <TabItem Header="Unos PP aparata">
                <ScrollViewer Padding="0,12,0,4"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <Border MaxWidth="1180"
                            Margin="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionKicker}"
                                           Text="UNOS PODATAKA" />
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Novi servisirani PP aparat" />
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource HelperText}"
                                           Text="Sva označena polja su obavezna. Sljedeći servis računa se automatski šest mjeseci od datuma servisa." />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Konto / kupac *" />
                                    <ComboBox x:Name="cmbKontoUnos"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              StaysOpenOnEdit="True"
                                              DisplayMemberPath="Prikaz"
                                              DropDownOpened="KontoComboBox_DropDownOpened"
                                              ToolTip="Upišite početak broja konta ili dio naziva kupca." />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Tip PP aparata *" />
                                    <ComboBox x:Name="cmbTip" />
                                </StackPanel>

                                <StackPanel Grid.Column="4"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Punjenje (kg) *" />
                                    <TextBox x:Name="txtPunjenje"
                                             MaxLength="12" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Serijski broj aparata *" />
                                    <TextBox x:Name="txtSerijskiBroj"
                                             MaxLength="100" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Godina proizvodnje *" />
                                    <TextBox x:Name="txtGodinaProizvodnje"
                                             MaxLength="4" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="4"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Datum servisa *" />
                                    <DatePicker x:Name="dpDatumServisa"
                                                SelectedDateChanged="DpDatumServisa_SelectedDateChanged" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Sljedeći servis" />
                                    <Border Height="40"
                                            Padding="10,0"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock x:Name="txtSljedeciServis"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Konstatacija ispravnosti *" />
                                    <TextBox x:Name="txtKonstatacija"
                                             MaxLength="100" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="4"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Vozilo *" />
                                    <TextBox x:Name="txtVozilo"
                                             MaxLength="100"
                                             ToolTip="Ako nije primjenjivo unesite N/A." />
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Grid.ColumnSpan="3">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Ispitivanje izvršio *" />
                                    <TextBox x:Name="txtIspitivanjeIzvrsio"
                                             MaxLength="150" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    Margin="0,24,0,0"
                                    Padding="0,18,0,0"
                                    BorderBrush="#E4E6E9"
                                    BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnSnimi"
                                            Margin="0,0,12,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Snimi aparat"
                                            Click="BtnSnimi_Click" />
                                    <Button Content="Očisti polja"
                                            Click="BtnOcisti_Click" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="txtUnosStatus"
                                       Grid.Row="3"
                                       MinHeight="22"
                                       Margin="0,14,0,0"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Izvještaji">
                <Grid Margin="2,12,2,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionKicker}"
                                           Text="IZVJEŠTAJI" />
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Mjesečni zapisnik" />
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource HelperText}"
                                           Text="Odaberite kupca i period za pregled ili generisanje DOCX zapisnika." />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.35*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Konto / kupac *" />
                                    <ComboBox x:Name="cmbKontoIzvjestaj"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              StaysOpenOnEdit="True"
                                              DisplayMemberPath="Prikaz"
                                              DropDownOpened="KontoComboBox_DropDownOpened"
                                              ToolTip="Upišite početak broja konta ili dio naziva kupca." />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Mjesec *" />
                                    <ComboBox x:Name="cmbMjesec" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Godina *" />
                                    <ComboBox x:Name="cmbGodina"
                                              IsEditable="True" />
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Broj zapisnika *" />
                                    <TextBox x:Name="txtBrojZapisnika"
                                             MaxLength="80" />
                                </StackPanel>

                                <StackPanel Grid.Column="8">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Datum zaključivanja *" />
                                    <DatePicker x:Name="dpDatumZakljucivanja" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    Margin="0,22,0,0"
                                    Padding="0,18,0,0"
                                    BorderBrush="#E4E6E9"
                                    BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnUcitajPregled"
                                            Margin="0,0,12,0"
                                            Content="Učitaj pregled"
                                            Click="BtnUcitajPregled_Click" />
                                    <Button x:Name="btnGenerisiDocx"
                                            Margin="0,0,12,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Generiši DOCX"
                                            Click="BtnGenerisiDocx_Click" />
                                    <Button x:Name="btnOtvoriWord"
                                            Content="Otvori u Wordu"
                                            IsEnabled="False"
                                            Click="BtnOtvoriWord_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="0"
                            Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="22,15"
                                    BorderBrush="#E4E6E9"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pregled servisiranih aparata"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtIzvjestajStatus"
                                               Grid.Column="1"
                                               MaxWidth="520"
                                               Margin="20,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <DataGrid x:Name="dgIzvjestaj"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      AlternationCount="2"
                                      AlternatingRowBackground="{StaticResource SurfaceMutedBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="R.br."
                                                        Binding="{Binding RedniBroj}"
                                                        Width="60" />
                                    <DataGridTextColumn Header="Tip"
                                                        Binding="{Binding Tip}"
                                                        Width="72" />
                                    <DataGridTextColumn Header="Punjenje kg"
                                                        Binding="{Binding PunjenjeKg, StringFormat={}{0:0.##}}"
                                                        Width="94" />
                                    <DataGridTextColumn Header="Serijski broj"
                                                        Binding="{Binding SerijskiBroj}"
                                                        Width="130" />
                                    <DataGridTextColumn Header="Godina"
                                                        Binding="{Binding GodinaProizvodnje}"
                                                        Width="76" />
                                    <DataGridTextColumn Header="Datum servisa"
                                                        Binding="{Binding DatumServisa, StringFormat={}{0:dd.MM.yyyy}}"
                                                        Width="110" />
                                    <DataGridTextColumn Header="Sljedeći servis"
                                                        Binding="{Binding SljedeciServis, StringFormat={}{0:dd.MM.yyyy}}"
                                                        Width="120" />
                                    <DataGridTextColumn Header="Ispravnost"
                                                        Binding="{Binding KonstatacijaIspravnosti}"
                                                        Width="120" />
                                    <DataGridTextColumn Header="Vozilo"
                                                        Binding="{Binding Vozilo}"
                                                        Width="120" />
                                    <DataGridTextColumn Header="Ispitivanje izvršio"
                                                        Binding="{Binding IspitivanjeIzvrsio}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="#E8EAED"
                BorderBrush="#D2D5DA"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7"
                         Height="7"
                         VerticalAlignment="Center"
                         Fill="{StaticResource PrimaryBrush}" />
                <TextBlock x:Name="txtGlobalStatus"
                           Grid.Column="1"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
