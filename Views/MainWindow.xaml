<Window x:Class="PpEvidencija.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidencija PP aparata"
        Width="1380"
        Height="850"
        MinWidth="1000"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryBrush}">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Evidencija PP aparata"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Unos servisiranih aparata i mjesečni zapisnici"
                               Foreground="#F8DEE4" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,7"
                        VerticalAlignment="Center"
                        Background="#2EFFFFFF"
                        CornerRadius="18">
                    <TextBlock x:Name="txtPrijavljeniKorisnik"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="24,16,24,12">
            <TabItem Header="Unos PP aparata">
                <ScrollViewer Padding="0,12,0,4"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <Border MaxWidth="1180"
                            Margin="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionKicker}"
                                           Text="UNOS PODATAKA" />
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Novi servisirani PP aparat" />
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource HelperText}"
                                           Text="Sva označena polja su obavezna. Sljedeći servis računa se automatski šest mjeseci od datuma servisa." />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Konto / kupac *" />
                                    <ComboBox x:Name="cmbKontoUnos"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              StaysOpenOnEdit="True"
                                              DisplayMemberPath="Prikaz"
                                              DropDownOpened="KontoComboBox_DropDownOpened"
                                              ToolTip="Upišite početak broja konta ili dio naziva kupca." />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Tip PP aparata *" />
                                    <ComboBox x:Name="cmbTip" />
                                </StackPanel>

                                <StackPanel Grid.Column="4"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Punjenje (kg) *" />
                                    <TextBox x:Name="txtPunjenje"
                                             MaxLength="12" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Serijski broj aparata *" />
                                    <TextBox x:Name="txtSerijskiBroj"
                                             MaxLength="100" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Godina proizvodnje *" />
                                    <TextBox x:Name="txtGodinaProizvodnje"
                                             MaxLength="4" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="4"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Datum servisa *" />
                                    <DatePicker x:Name="dpDatumServisa"
                                                SelectedDateChanged="DpDatumServisa_SelectedDateChanged" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Sljedeći servis" />
                                    <Border Height="40"
                                            Padding="10,0"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock x:Name="txtSljedeciServis"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Konstatacija ispravnosti *" />
                                    <TextBox x:Name="txtKonstatacija"
                                             MaxLength="100" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="4"
                                            Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Vozilo *" />
                                    <TextBox x:Name="txtVozilo"
                                             MaxLength="100"
                                             ToolTip="Ako nije primjenjivo unesite N/A." />
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Grid.ColumnSpan="3">
                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="Ispitivanje izvršio *" />
                                    <TextBox x:Name="txtIspitivanjeIzvrsio"
                                             MaxLength="150" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    Margin="0,24,0,0"
                                    Padding="0,18,0,0"
                                    BorderBrush="#E4E6E9"
                                    BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnSnimi"
                                            Margin="0,0,12,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Snimi aparat"
                                            Click="BtnSnimi_Click" />
                                    <Button Content="Očisti polja"
                                            Click="BtnOcisti_Click" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="txtUnosStatus"
                                       Grid.Row="3"
                                       MinHeight="22"
                                       Margin="0,14,0,0"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Izvještaji">
                <TabItem.Resources>
                    <SolidColorBrush x:Key="ReportOpenBackgroundBrush" Color="#FFF4E5" />
                    <SolidColorBrush x:Key="ReportOpenForegroundBrush" Color="#8A4B08" />
                    <SolidColorBrush x:Key="ReportClosedBackgroundBrush" Color="#E8F5EC" />
                    <SolidColorBrush x:Key="ReportClosedForegroundBrush" Color="#1F6B3A" />

                    <Style x:Key="ReportInlineLabel" TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,9,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>

                    <Style x:Key="ReportCenteredCell"
                           TargetType="DataGridCell"
                           BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>

                    <Style x:Key="ReportCenteredHeader"
                           TargetType="DataGridColumnHeader"
                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>

                    <Style TargetType="{x:Type DatePickerTextBox}">
                        <Setter Property="Padding" Value="9,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </TabItem.Resources>

                <Grid Margin="2,10,2,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="6*" />
                    </Grid.RowDefinitions>

                    <Border Padding="0"
                            Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="16,9"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="#E4E6E9"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="Kupci / konta" />
                                    <StackPanel Grid.Column="1"
                                                Margin="24,0,16,0"
                                                VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ReportInlineLabel}"
                                                       Text="Period" />
                                            <ComboBox x:Name="cmbMjesec"
                                                      Width="140"
                                                      VerticalContentAlignment="Center"
                                                      SelectionChanged="ReportFilter_SelectionChanged" />
                                            <ComboBox x:Name="cmbGodina"
                                                      Width="100"
                                                      Margin="7,0,0,0"
                                                      VerticalContentAlignment="Center"
                                                      SelectionChanged="ReportFilter_SelectionChanged" />
                                            <Border Width="1"
                                                    Height="24"
                                                    Margin="16,0"
                                                    Background="{StaticResource BorderBrush}" />
                                            <TextBlock Style="{StaticResource ReportInlineLabel}"
                                                       Text="Status" />
                                            <ComboBox x:Name="cmbStatusIzvjestaja"
                                                      Width="160"
                                                      VerticalContentAlignment="Center"
                                                      SelectionChanged="ReportFilter_SelectionChanged" />
                                            <Button x:Name="btnOsvjeziPregledKonta"
                                                    MinWidth="88"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Content="Osvježi"
                                                    ToolTip="Ponovo učitaj podatke iz baze."
                                                    Click="BtnOsvjeziPregledKonta_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="txtPregledKontaStatus"
                                               Grid.Column="2"
                                               MaxWidth="180"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <DataGrid x:Name="dgKontaIzvjestaji"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          AlternationCount="2"
                                          AlternatingRowBackground="{StaticResource SurfaceMutedBrush}"
                                          RowHeight="38"
                                          ColumnHeaderHeight="36"
                                          CellStyle="{StaticResource ReportCenteredCell}"
                                          ColumnHeaderStyle="{StaticResource ReportCenteredHeader}"
                                          SelectionChanged="DgKontaIzvjestaji_SelectionChanged"
                                          ToolTip="Kliknite red kupca da otvorite detalje izvještaja.">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow"
                                               BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Konto"
                                                            Binding="{Binding Konto}"
                                                            Width="115" />
                                        <DataGridTextColumn Header="Kupac"
                                                            Binding="{Binding NazivKupca}"
                                                            Width="2*" />
                                        <DataGridTextColumn Header="Aparati"
                                                            Binding="{Binding BrojAparata}"
                                                            Width="80" />
                                        <DataGridTemplateColumn Header="Status"
                                                                Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Padding="9,3"
                                                            CornerRadius="12">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource ReportOpenBackgroundBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Zakljucen}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource ReportClosedBackgroundBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Status}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource ReportOpenForegroundBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Zakljucen}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource ReportClosedForegroundBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Posljednja promjena"
                                                            Binding="{Binding PosljednjaPromjenaPrikaz}"
                                                            Width="260" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel x:Name="pnlPrazanPregled"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock x:Name="txtPrazanPregled"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="Učitavanje kupaca..."
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="pnlBezOdabranogKupca"
                            Grid.Row="2"
                            Padding="0"
                            Style="{StaticResource Card}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Odaberite kupca iz gornje tabele." />
                        </StackPanel>
                    </Border>

                    <Border x:Name="pnlOdabraniKupac"
                            Grid.Row="2"
                            Padding="0"
                            Style="{StaticResource Card}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="16,8"
                                    BorderBrush="#E4E6E9"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="txtOdabraniKupac"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Margin="0,2,0,0"
                                                    Orientation="Horizontal">
                                            <TextBlock x:Name="txtOdabraniPeriod"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" />
                                            <TextBlock x:Name="txtIzvjestajStatus"
                                                       Margin="10,0,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Border Padding="11,4"
                                                VerticalAlignment="Center"
                                                CornerRadius="13">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ReportOpenBackgroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Zakljucen}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource ReportClosedBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource ReportOpenForegroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Zakljucen}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ReportClosedForegroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button x:Name="btnPromijeniStatus"
                                                MinWidth="100"
                                                Margin="10,0,0,0"
                                                Content="Zaključi"
                                                IsEnabled="False"
                                                Click="BtnPromijeniStatus_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Padding="16,7"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="#E4E6E9"
                                    BorderThickness="0,0,0,1">
                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <TextBlock Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Text="DOCX" />
                                    <TextBlock Style="{StaticResource ReportInlineLabel}"
                                               Text="Datum" />
                                    <DatePicker x:Name="dpDatumZakljucivanja"
                                                Width="155"
                                                Height="38"
                                                Padding="8,0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                SelectedDateFormat="Short"
                                                Language="bs-Latn-BA" />
                                    <Button x:Name="btnGenerisiDocx"
                                            MinWidth="118"
                                            Margin="10,0,7,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Sačuvaj DOCX"
                                            IsEnabled="False"
                                            Click="BtnGenerisiDocx_Click" />
                                    <Button x:Name="btnOtvoriWord"
                                            MinWidth="105"
                                            VerticalAlignment="Center"
                                            Content="Otvori Word"
                                            IsEnabled="False"
                                            Click="BtnOtvoriWord_Click" />
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="dgIzvjestaj"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      AlternationCount="2"
                                      AlternatingRowBackground="{StaticResource SurfaceMutedBrush}"
                                      RowHeight="36"
                                      ColumnHeaderHeight="36"
                                      CellStyle="{StaticResource ReportCenteredCell}"
                                      ColumnHeaderStyle="{StaticResource ReportCenteredHeader}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="R.br."
                                                        Binding="{Binding RedniBroj}"
                                                        Width="55" />
                                    <DataGridTextColumn Header="Tip"
                                                        Binding="{Binding Tip}"
                                                        Width="70" />
                                    <DataGridTextColumn Header="Punjenje"
                                                        Binding="{Binding PunjenjeKg, StringFormat={}{0:0.##} kg}"
                                                        Width="90" />
                                    <DataGridTextColumn Header="Serijski broj"
                                                        Binding="{Binding SerijskiBroj}"
                                                        Width="125" />
                                    <DataGridTextColumn Header="Godina"
                                                        Binding="{Binding GodinaProizvodnje}"
                                                        Width="70" />
                                    <DataGridTextColumn Header="Datum servisa"
                                                        Binding="{Binding DatumServisa, StringFormat={}{0:dd.MM.yyyy}}"
                                                        Width="105" />
                                    <DataGridTextColumn Header="Sljedeći servis"
                                                        Binding="{Binding SljedeciServis, StringFormat={}{0:dd.MM.yyyy}}"
                                                        Width="115" />
                                    <DataGridTextColumn Header="Ispravnost"
                                                        Binding="{Binding KonstatacijaIspravnosti}"
                                                        Width="115" />
                                    <DataGridTextColumn Header="Vozilo"
                                                        Binding="{Binding Vozilo}"
                                                        Width="115" />
                                    <DataGridTextColumn Header="Ispitivanje izvršio"
                                                        Binding="{Binding IspitivanjeIzvrsio}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="#E8EAED"
                BorderBrush="#D2D5DA"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7"
                         Height="7"
                         VerticalAlignment="Center"
                         Fill="{StaticResource PrimaryBrush}" />
                <TextBlock x:Name="txtGlobalStatus"
                           Grid.Column="1"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
