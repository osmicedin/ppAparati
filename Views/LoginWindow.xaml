<Window x:Class="PpEvidencija.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prijava - Evidencija PP aparata"
        Width="480"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#9B1C31" />
                    <GradientStop Offset="0.31" Color="#8C192D" />
                    <GradientStop Offset="0.311" Color="#F3F4F6" />
                    <GradientStop Offset="1" Color="#F3F4F6" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Margin="34,0"
                    VerticalAlignment="Center">
            <TextBlock Text="EVIDENCIJA PP APARATA"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold" />
            <TextBlock Margin="0,7,0,0"
                       Text="Siguran pristup evidenciji servisiranih aparata"
                       Foreground="#F8DEE4" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="30,-20,30,28"
                Padding="24,20"
                Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Prijava"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           Style="{StaticResource HelperText}"
                           Text="Prijavite se svojim ERP korisničkim nalogom." />

                <TextBlock Grid.Row="3"
                           Style="{StaticResource FieldLabel}"
                           Text="Korisničko ime" />
                <TextBox x:Name="txtKorisnickoIme"
                         Grid.Row="4"
                         AutomationProperties.Name="Korisničko ime"
                         MaxLength="100" />

                <TextBlock Grid.Row="6"
                           Style="{StaticResource FieldLabel}"
                           Text="Lozinka" />
                <PasswordBox x:Name="txtLozinka"
                             Grid.Row="7"
                             AutomationProperties.Name="Lozinka"
                             MaxLength="200" />

                <TextBlock x:Name="txtStatus"
                           Grid.Row="8"
                           MinHeight="28"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />

                <Button x:Name="btnPrijava"
                        Grid.Row="9"
                        Height="42"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource PrimaryButton}"
                        Content="Prijava"
                        IsDefault="True"
                        Click="BtnPrijava_Click" />
                <Button x:Name="btnErpKonfiguracija"
                        Grid.Row="10"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Stretch"
                        Content="Konfiguracija ERP baze"
                        Click="BtnErpKonfiguracija_Click" />
            </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
